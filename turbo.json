{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SYNC_WORKER_SECRET",
        "CRON_SECRET",
        "DEPLOY_HEALTH_SECRET",
        "TINYOPS_APP_BASE_URL",
        "TINYOPS_DEPLOY_ENV",
        "TINYOPS_LOG_LEVEL",
        "OPENAI_API_KEY",
        "ASK_AI_MODEL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SYNC_WORKER_SECRET",
        "CRON_SECRET",
        "DEPLOY_HEALTH_SECRET",
        "TINYOPS_APP_BASE_URL",
        "TINYOPS_DEPLOY_ENV",
        "TINYOPS_LOG_LEVEL",
        "OPENAI_API_KEY",
        "ASK_AI_MODEL"
      ]
    }
  }
}
