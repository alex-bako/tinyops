NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key-from-pnpm-supabase-status
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-pnpm-supabase-status
TINYOPS_LOG_LEVEL=debug
TINYOPS_APP_BASE_URL=http://localhost:3000
SYNC_WORKER_SECRET=replace-with-random-local-secret
CRON_SECRET=replace-with-random-cron-secret
DEPLOY_HEALTH_SECRET=replace-with-random-health-secret
TINYOPS_DEPLOY_ENV=staging
# "Ask AI": OpenAI key (read by the @ai-sdk/openai provider) and the model id.
OPENAI_API_KEY=replace-with-openai-api-key
ASK_AI_MODEL=gpt-5.5
# Google Forms live sync: service-account JSON key file content (single line or base64).
# Leave empty to disable live sync; CSV upload keeps working. See docs/deployment.md.
GOOGLE_SERVICE_ACCOUNT_KEY=
