{
  "name": "tinyops",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "supabase:start": "pnpm dlx supabase@latest start",
    "supabase:stop": "pnpm dlx supabase@latest stop",
    "supabase:status": "pnpm dlx supabase@latest status",
    "supabase:reset": "pnpm dlx supabase@latest db reset",
    "supabase:migration:new": "pnpm dlx supabase@latest migration new",
    "supabase:test:workspace-rpc": "docker exec -i supabase_db_tinyops psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/tests/workspace_rpc_contract.sql",
    "supabase:types": "pnpm dlx supabase@latest gen types typescript --local > apps/web/lib/database.types.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  }
}
